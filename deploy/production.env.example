# Copy to deploy/production.env and replace every value marked required.
SECRET_KEY=replace-with-at-least-32-random-bytes
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Public browser origin used for CORS and share links.
PUBLIC_ORIGIN=http://localhost:8080
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Enable the optional TLS gateway with:
#   docker compose --profile tls ... up -d
# Use a real DNS name in production; Caddy will obtain and renew certificates.
SITE_ADDRESS=localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Keep one GPU/CPU worker per backend container. The active session registry is
# process-local, so do not run multiple backend replicas against one SQLite file.
FUNASR_DEVICE=cpu
FUNASR_NCPU=4
MAX_CONCURRENT_SESSIONS=4
JOB_HEAVY_WORKERS=1
JOB_LIGHT_WORKERS=2
ASR_MODE=normal

# Optional LLM minutes provider.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
