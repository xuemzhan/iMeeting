# ---------------------------------------------------------------------------
# 服务配置
# ---------------------------------------------------------------------------

# 运行环境：development / production。
# production 会拒绝弱 SECRET_KEY、默认管理员口令、关闭鉴权和通配 CORS。
APP_ENV=development

# JWT 签名密钥。生产环境务必修改，否则令牌可被伪造。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 配置字段加密密钥（可选）。留空则从 SECRET_KEY 派生。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_ENCRYPTION_KEY=

# 数据库。默认 SQLite，生产可换 PostgreSQL：
# postgresql+psycopg://user:pass@localhost:5432/meeting
DATABASE_URL=

# 服务监听
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173

# 登录令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 首次启动创建的管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---------------------------------------------------------------------------
# ASR 推理
# ---------------------------------------------------------------------------

# 识别模式：
#   normal = 真实 FunASR 识别
#   echo   = 回声模式，不加载模型，回显占位文本（联调前后端链路时用）
#   off    = 只采集音频，不产生文字
ASR_MODE=normal

# 推理设备：cpu / cuda:0 / mps / npu:0
FUNASR_DEVICE=cpu

# CPU 线程数
FUNASR_NCPU=4

# 最大并发会话数。CPU 环境建议不超过物理核数的一半。
MAX_CONCURRENT_SESSIONS=4

# 设为 1 跳过启动时的模型预热（调试用，首次请求会变慢）
SKIP_MODEL_WARMUP=0

# 设为 1 强制 WebSocket 携带有效令牌
REQUIRE_AUTH=0

# ---------------------------------------------------------------------------
# LLM 纪要（也可在后台界面配置）
# ---------------------------------------------------------------------------

# 任何 OpenAI 兼容端点。本地 vLLM 示例：http://localhost:8000/v1
LLM_BASE_URL=

LLM_API_KEY=

LLM_MODEL=
